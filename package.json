{
  "name": "contratacr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run text:check",
    "dev": "node ./scripts/dev-local-test-env.js",
    "build": "npm run text:check && next build",
    "start": "next start",
    "prelint": "npm run text:check",
    "lint": "eslint",
    "text:check": "node scripts/check-text-encoding.mjs",
    "security:env": "node scripts/check-private-env-files.mjs",
    "security:smoke": "node scripts/security-smoke.mjs",
    "supabase:templates:validate": "node scripts/sync-supabase-email-templates.mjs --validate-only",
    "audit:high": "npm audit --omit=dev --audit-level=high",
    "padron:check": "node scripts/check-padron.mjs",
    "padron:load": "node scripts/load-padron.mjs",
    "padron:prepare-copy": "node scripts/prepare-padron-copy.mjs",
    "seed:test:cleanup": "node scripts/cleanup-legacy-regression-fixtures.js --apply",
    "seed:test:full": "npm run seed:test:cleanup && node scripts/seed-regression-pair.js && node scripts/seed-regression-coverage.js",
    "seed:test:verify": "node scripts/verify-regression-pair.js",
    "test:account-deletion": "node scripts/verify-account-deletion-isolation.js",
    "test:push-isolation": "node scripts/verify-notification-push-isolation.js",
    "test:push-schema": "node scripts/verify-notification-push-schema-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@swc/helpers": "0.5.23",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "next-intl": "^4.13.0",
    "nodemailer": "9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "glob": {
      "minimatch": "10.2.5"
    },
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    },
    "postcss": "8.5.23",
    "uuid": "11.1.1"
  }
}
