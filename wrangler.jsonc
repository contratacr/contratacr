{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contratacr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "PADRON_D1",
      "database_name": "contratacr-padron"
    }
  ],
  "observability": {
    "enabled": true
  }
}
