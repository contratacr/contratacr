{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contratacr",
  "main": "cloudflare-worker.js",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Images binding for directory photo resizing (owner OK 2026-11-18).
  // Free plan: 5,000 unique transformations/month; over the limit new uploads
  // are rejected, never billed (src/lib/directory/photo-codec-cf-images.ts).
  // Directory launch flags (owner OK 2026-11-19). Not secrets: same value in test and
  // production. The CI build step sets the same DIR_ENABLED/PRO_ENABLED so pages
  // prerendered at build time agree with the runtime. EMAIL_MODE and the peppers
  // are per-environment secrets (cloudflare-compatibility.yml).
  "vars": {
    "DIR_ENABLED": "true",
    "PRO_ENABLED": "false",
    "EMAIL_PROVIDER": "brevo"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Caché de datos de Next (unstable_cache) en R2. Sin esto OpenNext usa una
  // caché vacía y cada consulta «en caché» iba a la base en cada visita (el
  // perfil enseñaba su esqueleto casi un segundo al recargar). Las claves
  // llevan el id de cada build, así que test y producción no se mezclan.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "contratacr-next-cache"
    }
    // Fotos subidas de lugares del directorio (decisión 2026-11-26: planes gratis; R2 da 10 GB y
    // salida gratis). PENDIENTE: el binding se agrega cuando el bucket exista, porque wrangler no
    // despliega un binding sin bucket. Pasos: `npx wrangler r2 bucket create contratacr-place-photos`
    // y luego agregar aquí { "binding": "PLACE_PHOTOS", "bucket_name": "contratacr-place-photos" }.
    // Sin el binding las fotos siguen en Supabase Storage (src/lib/directory/place-photo-store.ts).
  ],
  "d1_databases": [
    {
      "binding": "PADRON_D1",
      "database_name": "contratacr-padron"
    }
  ],
  "observability": {
    "enabled": false
  },
  // Source maps are not uploaded: observability is off, and with the directory the
  // encoded maps exceed the 60 MiB Cloudflare limit (67 MiB on 2026-11-19).
  "upload_source_maps": false
}
