{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contratacr",
  "main": "cloudflare-worker.js",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Sin binding de Cloudflare Images desde el 2026-11-26 (docs/storage-plan.md): las fotos
  // llegan ya redimensionadas desde el navegador y next/image va con images.unoptimized.
  // Directory launch flags (owner OK 2026-11-19). Not secrets: same value in test and
  // production. The CI build step sets the same DIR_ENABLED/PRO_ENABLED so pages
  // prerendered at build time agree with the runtime. EMAIL_MODE and the peppers
  // are per-environment secrets (cloudflare-compatibility.yml).
  "vars": {
    "DIR_ENABLED": "true",
    "PRO_ENABLED": "false",
    "EMAIL_PROVIDER": "brevo"
  },
  // Caché de datos de Next (unstable_cache) en R2. Sin esto OpenNext usa una
  // caché vacía y cada consulta «en caché» iba a la base en cada visita (el
  // perfil enseñaba su esqueleto casi un segundo al recargar). Las claves
  // llevan el id de cada build, así que test y producción no se mezclan.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "contratacr-next-cache"
    },
    // Fotos subidas de lugares del directorio (decisión 2026-11-26: planes gratis; R2 da 10 GB y salida
    // gratis). Bucket privado creado el 2026-11-26 en la cuenta del sitio. Test y producción lo comparten:
    // las claves llevan el host del proyecto Supabase (src/lib/directory/place-photo-store.ts).
    {
      "binding": "PLACE_PHOTOS",
      "bucket_name": "contratacr-place-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "PADRON_D1",
      "database_name": "contratacr-padron"
    }
  ],
  "observability": {
    "enabled": false
  },
  // Source maps are not uploaded: observability is off, and with the directory the
  // encoded maps exceed the 60 MiB Cloudflare limit (67 MiB on 2026-11-19).
  "upload_source_maps": false
}
