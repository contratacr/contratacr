/.well-known/apple-app-site-association
  Content-Type: application/json

# Public home artwork can be reused immediately on the next app session.
# Files are not immutable: future replacements revalidate after one day.
/hero/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/featured-brands/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/.well-known/assetlinks.json
  Content-Type: application/json

# Self-hosted map label glyphs (Noto Sans, OFL — see /map-fonts/OFL.txt).
/map-fonts/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
