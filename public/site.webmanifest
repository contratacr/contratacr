{
  "id": "/",
  "name": "ContrataCR",
  "short_name": "ContrataCR",
  "description": "Ofrece y encuentra servicios en Costa Rica.",
  "start_url": "/abrir-app",
  "scope": "/",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "related_applications": [{ "platform": "play", "id": "com.contratacr.app", "url": "https://play.google.com/store/apps/details?id=com.contratacr.app" }],
  "prefer_related_applications": false,
  "lang": "es-CR"
}
