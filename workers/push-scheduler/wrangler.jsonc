{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "contratacr-push-scheduler-local-candidate",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": { "MODE": "off", "APP_ORIGIN": "https://contratacr.com" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "contratacr-push-scheduler",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      "vars": { "MODE": "check-only", "APP_ORIGIN": "https://contratacr.com" }
    }
  }
}
